# Copy to .env for local runs. On Vercel, set these under
# Project -> Settings -> Environment Variables, then REDEPLOY
# (environment changes never reach an existing build).

# --- Opus (required) ---
OPUS_SERVICE_KEY=
OPUS_WORKSPACE_ID=
OPUS_WORKFLOW_ID=a4d8bb6a-4dab-4562-8ad9-f034d1d794da
OPUS_BASE_URL=https://operator.opus.com

# --- Demo mode (default ON) ---
# The login page shows one-click Demo Clerk / Demo Approver / Demo Admin.
# Set to false for real use with personal accounts.
DEMO_MODE=true

# --- Sign-in (optional in demo mode) ---
# A long random string, 32+ characters. If unset, one is derived from
# OPUS_SERVICE_KEY (fine for a demo). Changing it signs everyone out.
SESSION_SECRET=
# Creates the first admin on first sign-in, only while no users exist.
BOOTSTRAP_ADMIN_EMAIL=soufiane.douhaib@aaico.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Soufiane Douhaib
SESSION_HOURS=12

# --- Human Task webhook (optional; recommended outside a demo) ---
# If set, the webhook URL in Opus must end in /<this value>.
WEBHOOK_SECRET=
# Keep equal to the Human Task node's timeout in Opus (drives the countdown).
REVIEW_TIMEOUT_MINUTES=10
# true lets an approver decide on an invoice they submitted themselves.
ALLOW_SELF_REVIEW=false

# --- Storage ---
# Connect a KV / Upstash Redis store in Vercel -> Storage and these are injected
# automatically (possibly with a prefix, which is fine). Either pair works:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# REDIS_URL=

# --- Workflow variable ids (only if Opus regenerates them) ---
# OPUS_INPUT_INVOICE=workflow_input_fc7cbfofm
# OPUS_INPUT_PURCHASE_ORDER=workflow_input_8upjan24d
