# =============================================================================
# AP Invoice Validation UI - environment variables
# Local: copy to .env.   Vercel: Project -> Settings -> Environments ->
# Production -> Environment Variables, then REDEPLOY (env changes never reach
# an existing build).
# Lines marked (optional) can be left out; the app has working defaults.
# =============================================================================

# --- Opus connection ---------------------------------------------------------
# Confirm the correct host for your Opus environment - see the API reference, section 2.
OPUS_BASE_URL=https://operator.opus.com

# Server-side only. Service key of the account that owns the workflow
# (Finance & Accounting workspace). NEVER expose to the browser or commit it.
OPUS_SERVICE_KEY=<paste-your-service-key-here>

# Workspace files are uploaded into (/job/file/upload, accessScope=workspace).
# (optional) The app reads it from the workflow itself; this is the fallback.
# Workspace: "Finance & Accounting".
OPUS_WORKSPACE_ID=b01da1de-0e8e-441c-bc96-87e8ed0f6506

# AP Invoice Validation workflow (API runs use the ACTIVE version - currently 6.1).
OPUS_WORKFLOW_ID=a4d8bb6a-4dab-4562-8ad9-f034d1d794da

# /job/execute requires callbackUrl to be a real URL (an empty string 400s).
# This app polls job status instead, so a placeholder that passes validation is enough.
# (optional) Defaults to https://example.com/opus-callback
OPUS_CALLBACK_URL=https://example.com/opus-callback

# --- Workflow inputs (workflow_input_* ids, read off the builder canvas) -----
# (optional) Defaults below are built in; set only if Opus regenerates the ids.
# The clerk uploads all three on the Submit page. The app accepts PDF only,
# max 4 MB each (Vercel request limit; files go through the app's server).
# Invoice: supplier tax invoice (invoice no., vendor, TRN, lines, VAT, total). File (Single).
OPUS_INPUT_INVOICE=workflow_input_fc7cbfofm
# Purchase Order: the PO the invoice bills against (PO no., vendor, ordered lines, prices). File (Single).
OPUS_INPUT_PURCHASE_ORDER=workflow_input_8upjan24d
# Goods Receipt: GRN confirming what was delivered (GR no., PO ref, received quantities). File (Single).
OPUS_INPUT_GOODS_RECEIPT=workflow_input_6t6ox3vk4

# --- Main Output node variables (workflow_output_* ids) ----------------------
# (optional) Defaults below are built in.
# Payment Object: approved/held payment record (vendor, amounts, outcome). Object.
OPUS_OUTPUT_PAYMENT_OBJECT=workflow_output_ktpjr7h2v
# Audit Trail: match results, exceptions and decisions with metadata. Object.
OPUS_OUTPUT_AUDIT_TRAIL=workflow_output_zx8kqm9p1
# Justification Summary: human-readable summary of the outcome (Markdown). Text.
OPUS_OUTPUT_JUSTIFICATION_SUMMARY=workflow_output_jb2nmeq6z

# --- Human-in-the-loop (Off-Platform Task -> this app's Reviews page) --------
# Webhook to set on the Off-Platform Task in Opus:
#   https://<your-vercel-domain>/api/opus-webhook/human-review
# (or .../human-review/<WEBHOOK_SECRET> if WEBHOOK_SECRET is set)
# (optional) Review node id, used to spot a run parked at the review step.
OPUS_HUMAN_NODE_ID=5b8d6961-fdc1-4c35-ab2c-a195671b2b58
# Task inputs shown to the AP Approver (matched by id, then by name, so they
# survive Opus regenerating ids). (optional)
# Exception Brief Manifest: numbered list of match exceptions. Object.
OPUS_REVIEW_INPUT_EXCEPTION_BRIEF=workflow_input_1xarf585r
# Analyst Presentation: the exceptions written up for the approver. Text (Markdown).
OPUS_REVIEW_INPUT_ANALYST_PRESENTATION=workflow_input_7sy7k0gel
# Task output the decision is returned in ("Human Response", e.g.
# "approve 1 and 3, dispute 2"). Text. Read from each dispatch's
# expected_output_schema first; this is only the fallback. (optional)
OPUS_REVIEW_OUTPUT_RESPONSE=workflow_output_ojzd94z8j
# Callback value shape: bare (Opus docs, default) or wrapped ({value,type}). (optional)
CALLBACK_VALUE_FORMAT=bare
# Keep equal to the review task's timeout in Opus, in minutes (drives the
# approver's countdown). 1440 = 24 hours.
REVIEW_TIMEOUT_MINUTES=1440
# (optional) Secret path segment on the webhook URL. Empty = no secret.
WEBHOOK_SECRET=
# true lets an approver decide on an invoice they submitted themselves.
ALLOW_SELF_REVIEW=false

# --- Sign-in / demo ----------------------------------------------------------
# Demo mode: login page shows one-click Demo Clerk / Demo Approver / Demo Admin.
# Set false for real use with personal accounts.
DEMO_MODE=true
# (optional) 32+ random characters; derived from OPUS_SERVICE_KEY if unset.
SESSION_SECRET=
# (optional) Session length in hours.
SESSION_HOURS=12
# (optional, only when DEMO_MODE=false) First admin, created while no users exist.
BOOTSTRAP_ADMIN_EMAIL=soufiane.douhaib@aaico.com
BOOTSTRAP_ADMIN_NAME=Soufiane Douhaib
BOOTSTRAP_ADMIN_PASSWORD=

# --- Storage (Upstash Redis) - cases, users, pending review dispatches -------
# Connecting Upstash in Vercel -> Storage injects these automatically (a name
# prefix is fine: the app matches by suffix). Either pair works:
KV_REST_API_URL=<https://your-db.upstash.io>
KV_REST_API_TOKEN=<your-upstash-token>
# REDIS_URL=rediss://default:<password>@<host>:6379
